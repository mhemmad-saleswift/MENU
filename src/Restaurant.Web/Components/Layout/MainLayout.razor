@inherits LayoutComponentBase
@inject LanguageState Lang

<main class="page-frame">
    @* The page is the framed VIVA ITALIA menu card. Its top carries the logo (link home) and the
       language menu; its bottom carries the admin link. Both scroll with the page. *@
    <div class="frame-top-wrap">
        <a class="frame-top" href="/" aria-label="@Lang["brand"] — @Lang["nav.home"]"></a>
        <LanguageMenu />
    </div>
    <div class="frame-body">
        @Body
    </div>
    <div class="frame-bottom">
        <a class="frame-admin" href="/admin" title="@Lang["nav.admin"]" aria-label="@Lang["nav.admin"]">⚙️</a>
    </div>
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
