@inherits LayoutComponentBase
@inject LanguageState Lang

<SiteHeader />

<main class="page-frame">
    @* Frame pieces; only the Royal theme shows them (see app.css). With the header bar hidden
       in Royal, the VIVA ITALIA logo at the top of the frame is the link back home. *@
    <a class="frame-top" href="/" aria-label="@Lang["brand"] — @Lang["nav.home"]"></a>
    <div class="frame-body">
        @Body
    </div>
    <div class="frame-bottom" aria-hidden="true"></div>
</main>

<footer class="site-footer">
    <div class="container">
        <div class="brand"><span class="dot"></span>@Lang["brand"]</div>
        <p class="muted">© @DateTime.Now.Year @Lang["brand"] · Crafted with care · @Lang.Current.NativeName()</p>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
