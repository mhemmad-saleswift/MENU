@inject LanguageState Lang
@inject NavigationManager Nav
@inject IHttpContextAccessor Http

@{
    var path = new Uri(Nav.Uri).PathAndQuery;
    var ret = Uri.EscapeDataString(path);
    var theme = Themes.Normalize(Http.HttpContext?.Request.Cookies["theme"]);
}

<header class="site-header">
    <div class="container">
        <a class="brand" href="/"><span class="dot"></span>@Lang["brand"]</a>

        <nav class="main-nav">
            <a href="/" class="@Active("/")"><span class="nav-label">@Lang["nav.home"]</span></a>
            <a href="/menu" class="@Active("/menu")"><span class="nav-label">@Lang["nav.menu"]</span></a>
        </nav>

        <div class="header-tools">
            <details class="lang-menu">
                <summary class="icon-btn" title="Language">🌐</summary>
                @* Full page load (not enhanced navigation): the interactive circuit captures the culture
                   when it starts, so only a fresh load re-renders interactive pages in the new language. *@
                <div class="lang-dropdown">
                    <a class="@(Lang.Current == Language.English ? "sel" : "")" data-enhance-nav="false" href="/set-language/en?returnUrl=@ret">English <span>EN</span></a>
                    <a class="@(Lang.Current == Language.Arabic ? "sel" : "")" data-enhance-nav="false" href="/set-language/ar?returnUrl=@ret">العربية <span>AR</span></a>
                    <a class="@(Lang.Current == Language.Hebrew ? "sel" : "")" data-enhance-nav="false" href="/set-language/he?returnUrl=@ret">עברית <span>HE</span></a>
                </div>
            </details>

            <details class="lang-menu theme-menu">
                <summary class="icon-btn" title="@Lang["theme.label"]" aria-label="@Lang["theme.label"]">@Themes.Icon(theme)</summary>
                <div class="lang-dropdown">
                    @foreach (var (id, icon) in Themes.All)
                    {
                        <a class="@(theme == id ? "sel" : "")" href="/set-theme/@id?returnUrl=@ret">@Lang[$"theme.{id}"] <span>@icon</span></a>
                    }
                </div>
            </details>
            <a class="icon-btn" href="/admin" title="Admin">⚙️</a>
        </div>
    </div>
</header>

@code {
    string Active(string href)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (string.IsNullOrEmpty(path)) path = "/";
        return path == href.TrimEnd('/') || (href == "/" && path == "/") ? "active" : "";
    }
}
